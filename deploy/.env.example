# --- MasterHand ---
# Copy this file to deploy/.env and fill in the values.
# The real .env is NEVER committed.

# UI access password (the browser never sees this env).
# NODE_ENV=production requires at least 12 characters (values that already met the
# previous 32-byte floor keep working) and rejects example/placeholder values.
# Use a passphrase: length matters more than symbols.
MASTERHAND_PASSWORD=

# Secret used to sign session cookies and device tokens. Generate with: openssl rand -hex 32
# Production requires at least 32 bytes and rejects placeholders (`changeme`, `example`, ...).
SESSION_SECRET=

# Session/token lifetime (hours) and the cookie Secure flag.
# Booleans accept true/false, 1/0, yes/no, on/off (case-insensitive); anything
# else aborts boot. Empty is not a valid value: unset it or use false.
SESSION_TTL_HOURS=720
COOKIE_SECURE=true

# Extra origins allowed to mutate with a cookie (CSRF allowlist, comma-separated).
# This is NOT the CORS allowlist: bearer requests from any origin are allowed by
# design (without credentials) for multi-server clients. Only needed when a
# separate origin proxies to the BFF (for example a Vite dev server).
ALLOWED_ORIGINS=

# Host port/bind address for the BFF. Bind to 127.0.0.1 when your TLS proxy runs on the host.
MASTERHAND_BIND=0.0.0.0
MASTERHAND_PORT=8787

# Compose project name: prefixes the containers, the network and the named
# volumes (SQLite, opencode data and credentials). Production defaults to
# `masterhand` (docker-compose.yml `name:`); the dev overlay defaults to
# `masterhand-dev`, so `npm run dev` and a production stack can run on the same
# host without renaming anything. Set this only to choose another name (for
# example `masterhand-prod` for several production stacks on one host). The
# watchdog and the updater follow it automatically. Changing it after the first
# boot points the stack at NEW, empty volumes: copy the old ones first (see
# docs/runbooks/deployment.md §7).
# COMPOSE_PROJECT_NAME=masterhand

# --- Releases and in-app updates (#131) ---
# Pin the published image instead of floating on `latest` (see
# docs/runbooks/deployment.md §Releases). The release workflow builds and
# pushes `ghcr.io/togudv/masterhand:<version>` plus `:latest` for every tag.
MASTERHAND_VERSION=latest
# Build id baked into local builds (release images use the commit SHA).
# MASTERHAND_BUILD=dev
# Where the BFF fetches its `version.json` manifest for `GET /api/update`.
# The web/desktop notice and the Android notice both read it through the BFF,
# so no client ever contacts GitHub directly (privacy: one outbound fetch per
# TTL window, server-side only).
# UPDATE_MANIFEST_URL=https://github.com/togudv/masterhand/releases/latest/download/version.json

# --- One-click BFF updater (#134, opt-in) ---
# Enables the "Update now" button in web/desktop. Requires the `updater`
# Compose profile and a floating `MASTERHAND_VERSION=latest` above; a pinned
# tag keeps the manual `docker compose pull && up -d` flow. The sidecar is the
# only container with the Docker socket and can only recreate the masterhand
# service. Generate the shared token once with: openssl rand -hex 32
# Start it with: docker compose --profile updater up -d
# MASTERHAND_UPDATE_URL=http://updater:8080
# MASTERHAND_UPDATE_TOKEN=

# --- Resource and log limits (protect the host) ---
# Container log cap (both services). Agent output can be huge; the host disk is
# shared with SQLite and the workspaces.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
# Hard CPU/memory caps so a runaway build cannot take the BFF/SQLite/host down.
# Raise them when a build legitimately needs more (the BFF container is light).
MASTERHAND_CPUS_LIMIT=1
MASTERHAND_MEMORY_LIMIT=1g
OPENCODE_CPUS_LIMIT=2
OPENCODE_MEMORY_LIMIT=4g
# Node heap caps leave headroom for native buffers, SSE queues and upload
# copies below the cgroup limit; GC runs before Docker's OOM killer arrives.
MASTERHAND_HEAP_MB=768
OPENCODE_HEAP_MB=2048
# Process caps (fork-bomb protection). The opencode cap is generous because a
# real build spawns many children.
MASTERHAND_PIDS_LIMIT=256
OPENCODE_PIDS_LIMIT=1024
# OOM priority: the engine/BFF are protected, agent shells raise their own
# score to +500 through agent-exec so a runaway build dies first.
MASTERHAND_OOM_SCORE_ADJ=-500
OPENCODE_OOM_SCORE_ADJ=-500

# --- Resilience supervisor (watchdog) ---
# Shared token between the BFF and the watchdog sidecar:
#   openssl rand -hex 32
# Empty keeps automatic restarts but hides the status panel/banner controls
# (`supervisor: false`); set it to see incidents and use "Start engine".
WATCHDOG_TOKEN=
# Restart budget: 3 attempts, and 5 minutes of continuous health resets it.
# A service that keeps failing within that window opens the circuit and is
# stopped (the BFF keeps the banner; start it manually to reset the budget).
# WATCHDOG_MAX_ATTEMPTS=3
# WATCHDOG_STABILITY_MS=300000
# WATCHDOG_STARTUP_GRACE_MS=180000
# WATCHDOG_RESTART_COOLDOWN_MS=30000
# WATCHDOG_UNHEALTHY_SAMPLES=2
# WATCHDOG_MEMORY_SAMPLES=6
# WATCHDOG_MEMORY_PCT=95
# WATCHDOG_STOP_ON_CIRCUIT=true
# Optional external alert for incidents/circuit-open (ntfy, Slack webhook, …).
# The request is best effort (5 s timeout) and never blocks a restart.
# WATCHDOG_WEBHOOK_URL=

# --- Resilience: automatic recovery (BFF) ---
# Re-drive in-flight goal/scheduled runs after a restart. Only runs that were
# in flight are touched; a user pause/cancel is never resumed.
RESILIENCE_AUTO_RESUME=true
# Send one continuation prompt for interrupted chat turns (max 3 per incident,
# one at a time). The prompt tells the agent to verify state and avoid heavy
# work. Set to false to leave the "Continue" button as the only path.
RESILIENCE_AUTO_CONTINUE_CHATS=true
RESILIENCE_MAX_CHAT_RESUMES=3
RESILIENCE_RESUME_GAP_MS=30000
# How long to wait for opencode after a reconnect and how long it must stay
# healthy before a continuation is injected.
# RESILIENCE_RECOVERY_TIMEOUT_MS=60000
# RESILIENCE_RECOVERY_MIN_OUTAGE_MS=3000
# RESILIENCE_HEALTH_GRACE_MS=30000
# Free space on the data volume below which /api/status reports storage.low and
# clients show a disk warning. 0 disables the warning.
DISK_LOW_WATERMARK_MB=512

# Host directory mounted into opencode as /workspace. Every workspace you add from
# the UI is created as a subfolder inside it (isolated from the others).
WORKSPACES_DIR=../workspace

# --- git ---
# Author used for the initial commit when a workspace is not a git repo yet
# (so opencode resolves its project root to the workspace, not an ancestor).
GIT_COMMIT_NAME=MasterHand
GIT_COMMIT_EMAIL=masterhand@localhost

# --- opencode (internal) ---
# opencode server password; only the BFF knows it
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

# opencode version installed in the image (pin it in production).
# MasterHand targets opencode v2; `@opencode/cli` ships v2 only.
OPENCODE_VERSION=2.0.6
# GitHub CLI version installed in the opencode image (Settings > GitHub).
GH_VERSION=2.102.0

# --- Agent toolbox (opencode image build) ---
# Developer tooling baked into the agent image at build time:
#   minimal  — only the base tools (curl, git, ripgrep, gh, opencode)
#   standard — adds a compiler (python3/make/g++), DB clients (psql, mysql,
#              sqlite3, redis-cli), jq, lsof, shellcheck, git-lfs, pnpm/yarn
#   full     — adds ffmpeg plus a Playwright Chromium (default)
# Installed as root while building; agent shells still run as uid 1001 without
# elevation, so this changes what exists, never who may run it. Raise
# OPENCODE_* limits if a build needs more CPU/RAM.
AGENT_TOOLBOX=full
# Playwright browser baked into the image: auto (chromium when the toolbox is
# full) | chromium | none. It lives under the agent's HOME, so a project on a
# different Playwright version downloads its own at runtime.
PLAYWRIGHT_BROWSERS=auto
# Playwright version pinned for the baked browser; align it with your projects.
PLAYWRIGHT_VERSION=1.64.1

# Custom OpenAI-compatible providers and the web search default. MasterHand
# writes them to a config file it owns inside opencode's global config dir,
# loaded with OPENCODE_CONFIG (set in docker-compose.yml). Defaults to
# ~/.config/opencode/masterhand-providers.json; override only when the BFF and
# opencode do not share that directory.
# OPENCODE_CUSTOM_PROVIDERS_FILE=/home/node/.config/opencode/masterhand-providers.json

# Deadline for the BFF's internal opencode calls (session lists, commands,
# session create/delete, PTY/run control). A missed deadline answers 504
# `opencode_timeout`; the public proxy keeps its own 60s budget.
# OPENCODE_TIMEOUT_MS=10000
# Cap on /api/oc/* request bodies in MB (1-1024). Oversized bodies answer 413;
# login/device bodies are always capped at 64 KiB.
PROXY_BODY_LIMIT_MB=10
# Chat attachments: one file (MB), the per-session storage cap (MB) and the
# retention window for orphaned uploads (days; 0 disables the sweep). Files are
# stored under <workspace>/.masterhand/attachments and never sent inline to
# opencode above the small text/image/PDF thresholds.
ATTACHMENT_MAX_MB=50
ATTACHMENT_MAX_PER_SESSION_MB=1000
ATTACHMENT_TTL_DAYS=90
# Provider model discovery refuses loopback targets by default (SSRF guard).
# Enable only for a provider running in the same host/namespace as the BFF
# (native development; in Docker, 127.0.0.1 is the BFF container itself).
PROVIDERS_ALLOW_LOOPBACK=false

# --- GitHub integration ---
# The BFF writes git/gh credentials into AGENT_CONFIG_DIR (a shared volume
# mounted by both services). Leave this at the Compose default; native
# development leaves it unset and the settings UI reports that injection is
# unavailable. Tokens are created in Settings > GitHub.
# AGENT_CONFIG_DIR=/agent-config

# --- Session previews (Cloudflare quick tunnels) ---
# Commented lines show the default the code or Compose already applies; the
# uncommented ones are live values. Uncomment an override only when you need it.
# Each session gets a fixed port from this range; the agent is told to bind any
# web server to it, and the BFF runs `cloudflared tunnel --url` to expose it.
# Quick tunnels are PUBLIC and meant for testing only: anyone with the random
# trycloudflare.com URL can reach the preview. The BFF needs outbound Internet.
PREVIEW_ENABLED=true
PREVIEW_PORT_RANGE=3200-3299
# Quick tunnels announce their URL before the edge is ready; the BFF waits up
# to this many ms for the URL to answer before reporting "running". 0 disables
# the check (environments where the BFF cannot resolve trycloudflare.com).
PREVIEW_READINESS_MS=25000
# Host where the agent's dev server listens, as seen by the tunnel process.
# Compose sets this to the opencode service name; in native dev it defaults to
# the host in OPENCODE_URL.
# PREVIEW_ORIGIN=opencode
# Path or name of the cloudflared binary (bundled in the server image). Leave it
# unset: the probe retries a slow binary and re-checks after a failure by itself.
# CLOUDFLARED_BIN=cloudflared
# cloudflared release installed by a LOCAL image build (build arg). Ignored when
# you pull the published image, which already bundles it.
CLOUDFLARED_VERSION=2026.9.3
