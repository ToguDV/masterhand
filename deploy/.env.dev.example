# --- MasterHand — Docker development environment ---
# Copy this file to `deploy/.env.dev` (git-ignored) and adjust as needed:
#
#   cp deploy/.env.dev.example deploy/.env.dev
#
# `npm run dev` / `dev:web` / `dev:server` create it automatically from this
# example the first time. It uses the exact same variable names as the
# production `deploy/.env.example`, so the runtime contract does not change;
# only the values are development-friendly. It is never committed.

# UI access password (stored hashed in the session cookie; the browser never sees this env)
MASTERHAND_PASSWORD=dev-password

# Secret used to sign session cookies and device tokens (generate a real one with `openssl rand -hex 32`)
SESSION_SECRET=dev-session-secret-change-me

# Development runs over plain HTTP, so the cookie must not be Secure-only.
COOKIE_SECURE=false
SESSION_TTL_HOURS=720

# Origins allowed on mutating requests (the Vite dev server proxies to the BFF).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host bind/port for the BFF (published by Compose).
MASTERHAND_BIND=0.0.0.0
MASTERHAND_PORT=8787

# Host bind/port for the Vite dev server (web front end).
MASTERHAND_DEV_WEB_BIND=0.0.0.0
MASTERHAND_DEV_WEB_PORT=5173

# File watching in the dev container. Bind mounts from Windows drives (WSL2 /
# Docker Desktop) do not deliver inotify events, so Vite/tsx poll by default;
# set MASTERHAND_DEV_POLL=0 on a native Linux filesystem to use inotify.
MASTERHAND_DEV_POLL=1
MASTERHAND_DEV_POLL_INTERVAL=300

# Host directory mounted into opencode as /workspace (each workspace you add is
# a subfolder inside it). Relative to the deploy/ directory.
WORKSPACES_DIR=../workspace

# Author used for commits MasterHand creates in isolated worktrees.
GIT_COMMIT_NAME=MasterHand
GIT_COMMIT_EMAIL=masterhand@localhost

# Optional credentials so "Finish & PR" can push and open pull requests.
GH_TOKEN=
GITLAB_TOKEN=

# --- opencode (internal) ---
OPENCODE_SERVER_PASSWORD=dev-opencode-password
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_VERSION=2.0.6

# --- Session previews (Cloudflare quick tunnels) ---
PREVIEW_ENABLED=true
PREVIEW_PORT_RANGE=3200-3299
PREVIEW_READINESS_MS=25000
CLOUDFLARED_VERSION=2026.9.3
