{
  "name": "masterhand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "overrides": {
    "react-native": "0.86.3"
  },
  "scripts": {
    "dev": "node scripts/dev-docker.mjs web",
    "dev:web": "node scripts/dev-docker.mjs web",
    "dev:server": "node scripts/dev-docker.mjs server",
    "dev:desktop": "node scripts/dev-docker.mjs desktop",
    "dev:mobile": "node scripts/dev-docker.mjs mobile",
    "dev:stop": "node scripts/dev-docker.mjs stop",
    "dev:restart": "node scripts/dev-docker.mjs restart",
    "dev:logs": "node scripts/dev-docker.mjs logs",
    "dev:native:web": "node scripts/dev.mjs web",
    "dev:native:server": "node scripts/dev.mjs server",
    "dev:native:desktop": "node scripts/dev.mjs desktop",
    "dev:native:mobile": "node scripts/dev.mjs mobile",
    "dev:native:stop": "node scripts/stop.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @masterhand/e2e",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e:browsers": "npm run e2e:browsers -w @masterhand/e2e",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  }
}
