# --- MasterHand BFF — native development environment ---
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Used only by the native fallback (`npm run dev:native:*`). The default
# Docker development stack reads `deploy/.env.dev` instead (see
# `docs/runbooks/development.md`).

# UI access password for local development.
MASTERHAND_PASSWORD=dev-password

# Signs session cookies and device tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-me

# Local development runs over plain HTTP, so the cookie must not be Secure-only.
COOKIE_SECURE=false

# Where a locally running `opencode serve` listens.
OPENCODE_URL=http://127.0.0.1:4096

# --- Optional overrides (defaults shown) ---
# Deadline for the BFF's internal opencode calls (session lists, commands,
# session create/delete, PTY/run control). A missed deadline answers 504
# `opencode_timeout`. The public proxy keeps its own 60s budget.
# OPENCODE_TIMEOUT_MS=10000
# Set to 1 to reuse an already-running opencode instead of starting one.
# MASTERHAND_SKIP_OPENCODE=1
# PORT=8787
# DATA_DIR=/absolute/path   (default: <repo-root>/data; relative values resolve against the repo root)
# SESSION_TTL_HOURS=720
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WEB_DIST=apps/web/dist
# Base directory for workspaces (each one is a subfolder created here).
# WORKSPACES_ROOT=/absolute/path   (default: <repo-root>/workspace; relative values resolve against the repo root)
# Base directory for isolated-session git worktrees; keep it inside the mount
# opencode sees. (default: <WORKSPACES_ROOT>/.worktrees)
# WORKTREES_ROOT=/absolute/path
# Author for commits MasterHand creates in isolated worktrees.
# GIT_COMMIT_NAME=MasterHand
# GIT_COMMIT_EMAIL=masterhand@localhost
# Session previews (Cloudflare quick tunnels). Requires the `cloudflared`
# binary on PATH for native development (bundled in the Docker image).
# PREVIEW_ENABLED=true
# PORT_RANGE is the fixed port pool reserved per session; PREVIEW_ORIGIN is the
# host where the agent's dev server listens as seen by the tunnel process
# (default: host of OPENCODE_URL, i.e. 127.0.0.1 in development).
# PREVIEW_PORT_RANGE=3200-3299
# PREVIEW_ORIGIN=127.0.0.1
# Wait for the fresh tunnel URL to answer before reporting "running" (ms; 0 disables).
# PREVIEW_READINESS_MS=25000
# CLOUDFLARED_BIN=cloudflared
