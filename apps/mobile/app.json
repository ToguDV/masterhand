{
  "expo": {
    "name": "MasterHand",
    "slug": "masterhand",
    "version": "0.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.togudv.masterhand"
    },
    "android": {
      "package": "dev.togudv.masterhand",
      "versionCode": 201
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
