{
  "expo": {
    "name": "MasterHand",
    "slug": "masterhand",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.togudv.masterhand"
    },
    "android": {
      "package": "dev.togudv.masterhand",
      "versionCode": 200
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
