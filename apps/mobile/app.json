{
  "expo": {
    "name": "MasterHand",
    "slug": "masterhand",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.togudv.masterhand",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "MasterHand connects to your self-hosted server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.togudv.masterhand",
      "versionCode": 301
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
